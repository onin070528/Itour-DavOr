APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL=http://localhost:8000
APP_URL=http://192.168.254.108:8000


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=db_itour
# DB_USERNAME=root
# DB_PASSWORD=

# Shared password for RbacDemoAccountSeeder's 3 demo accounts (development
# only — that seeder refuses to run when APP_ENV=production regardless of
# this value). See docs/DEV_ACCOUNTS.md.
SEED_DEMO_PASSWORD=itour-davor@2026

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Requires HTTPS — set to true in production, false for local http:// dev.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare Turnstile — login page CAPTCHA. These are Cloudflare's published
# "always passes" TEST keys (safe on localhost with no real domain yet).
# Swap for real site/secret keys from the Cloudflare dashboard before
# deploying to a real domain.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OpenAI — used ONLY to translate tourist feedback into English (Objective 4).
# Sentiment, issue detection, and recommendations never use AI. With no key,
# English feedback is still analyzed; other feedback is marked failed and can
# be retried later with: php artisan feedback:reprocess
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini

# Free-tier alternative: set TRANSLATION_PROVIDER=gemini and add a Google AI Studio
# key (https://aistudio.google.com/apikey). Leave TRANSLATION_PROVIDER as openai
# (or unset) to use OpenAI above.
TRANSLATION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest

VITE_APP_NAME="${APP_NAME}"
# Optional: this PC's LAN IP (from ipconfig) so a phone on the same Wi-Fi can
# load Vite dev assets, e.g. 192.168.1.10. Leave empty for normal local dev.
VITE_DEV_LAN_HOST=
